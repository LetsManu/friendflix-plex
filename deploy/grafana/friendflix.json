{
  "__inputs": [],
  "uid": "friendflix",
  "title": "FriendFlix",
  "description": "FriendFlix portal: backend + gateway Prometheus metrics (deploy/grafana/friendflix.json)",
  "tags": [
    "friendflix"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "type": "custom",
        "name": "backend_job",
        "label": "Backend job",
        "query": "friendflix-backend",
        "current": {
          "text": "friendflix-backend",
          "value": "friendflix-backend"
        },
        "hide": 0,
        "options": [
          {
            "text": "friendflix-backend",
            "value": "friendflix-backend",
            "selected": true
          }
        ],
        "description": "Prometheus job label of the backend scrape (compose.monitoring.yaml: friendflix-backend)"
      },
      {
        "type": "custom",
        "name": "gateway_job",
        "label": "Gateway job",
        "query": "friendflix-gateway",
        "current": {
          "text": "friendflix-gateway",
          "value": "friendflix-gateway"
        },
        "hide": 0,
        "options": [
          {
            "text": "friendflix-gateway",
            "value": "friendflix-gateway",
            "selected": true
          }
        ],
        "description": "Prometheus job label of the gateway scrape"
      }
    ]
  },
