    "ioredis": "^6.0.0",
    "openid-client": "^6.1.7",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "vitest": "^5.0.3"
  }
