{
  "name": "friendflix",
  "private": true,
  "type": "module",
  "version": "1.1.0",
  "license": "AGPL-3.0-or-later",
  "engines": { "node": ">=22" },
  "workspaces": ["backend", "gateway", "web", "updater"],
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces && tsc -p e2e/tsconfig.json",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "coverage": "npm run coverage --workspaces --if-present",
    "test:scripts": "node --test scripts/*.test.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "spdx:check": "node scripts/spdx.mjs --check",
    "spdx:fix": "node scripts/spdx.mjs --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.18.0"
  }
}
