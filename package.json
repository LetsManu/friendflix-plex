{
  "name": "friendflix",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "engines": { "node": ">=22" },
  "workspaces": ["backend", "gateway", "web"],
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces && tsc -p e2e/tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.18.0"
  }
}
